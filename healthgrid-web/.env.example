# .env.example

# Database (PostgreSQL required)
DATABASE_URL="postgresql://healthgrid:healthgrid_password@localhost:5432/healthgrid?schema=public"

# Groq API for AI Health Copilot
GROQ_API_KEY="your_groq_api_key_here"

# Optional: Vercel KV for caching (if deployed to Vercel)
KV_URL="redis://..."
KV_REST_API_URL="https://..."
KV_REST_API_TOKEN="your_token"
